[Unit]
Description=Hesbah Offer Marketplace
After=network.target

[Service]
Type=simple
User=amir
WorkingDirectory=/home/amir/hesbah-offer
Environment=NODE_ENV=production
Environment=PORT=8090
EnvironmentFile=-/home/amir/hesbah-offer/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
